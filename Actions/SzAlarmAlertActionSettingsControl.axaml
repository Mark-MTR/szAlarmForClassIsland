<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             mc:Ignorable="d"
             x:Class="SzAlarmPlugin.Actions.SzAlarmAlertActionSettingsControl">
    <StackPanel Spacing="4">
        <TextBlock Text="深圳气象预警提醒" Theme="{StaticResource SubtitleTextBlockStyle}" Margin="0 0 0 4" />

        <ci:Field Label="播报策略" Margin="0 0 0 8">
            <ComboBox SelectedIndex="{Binding Settings.AnnounceMode}">
                <ComboBoxItem>每次触发都播报</ComboBoxItem>
                <ComboBoxItem>同一预警仅首次播报</ComboBoxItem>
            </ComboBox>
        </ci:Field>

        <ci:Field Label="地名关键词" Margin="0 0 0 8">
            <TextBox Text="{Binding Settings.Regions}" Watermark="空格分隔，留空=所有地区" />
        </ci:Field>

        <ci:Field Label="灾害种类关键词" Margin="0 0 0 8">
            <TextBox Text="{Binding Settings.Types}" Watermark="空格分隔，留空=所有种类" />
        </ci:Field>

        <ci:Field Label="预警级别关键词" Margin="0 0 0 8">
            <TextBox Text="{Binding Settings.Levels}" Watermark="白 蓝 黄 橙 红，空格分隔，留空=所有级别" />
        </ci:Field>

        <!-- 速度：步进 0.5，显示一位小数；时长：步进 1，显示整数 -->
        <ci:Field Label="正文滚动速度" Margin="0 0 0 8" Suffix="(1=慢, 20=快)">
            <Grid ColumnDefinitions="*,Auto">
                <Slider Grid.Column="0" Minimum="1" Maximum="20"
                        TickFrequency="0.5" IsSnapToTickEnabled="True"
                        Value="{Binding Settings.ScrollSpeed}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                           MinWidth="40" TextAlignment="Right"
                           Text="{Binding Settings.ScrollSpeed, StringFormat={}{0:0.0}}" />
            </Grid>
        </ci:Field>

        <ci:Field Label="最大显示时长" Margin="0 0 0 8" Suffix="秒">
            <Grid ColumnDefinitions="*,Auto">
                <Slider Grid.Column="0" Minimum="10" Maximum="90"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding Settings.MaxDuration}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                           MinWidth="48" TextAlignment="Right"
                           Text="{Binding Settings.MaxDuration, StringFormat={}{0} 秒}" />
            </Grid>
        </ci:Field>

        <ci:Field Label="执行方式" Margin="0 0 0 8">
            <StackPanel Spacing="2">
                <CheckBox Content="等待预警播报结束再继续执行后续行动"
                          IsChecked="{Binding Settings.WaitForCompletion}" />
                <TextBlock Text="不勾选则立即返回，后续行动与预警播报并行执行。"
                           FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
            </StackPanel>
        </ci:Field>

        <Button x:Name="ClearBtn" Content="清除已播记录" Margin="0 4 0 0" Click="ClearBtn_OnClick" />
    </StackPanel>
</UserControl>
