<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="SzAlarmPlugin.Notifications.SzAlarmMaskControl">
    <StackPanel Orientation="Horizontal" Spacing="10"
                VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- 遮罩小图标：边框与图标同尺寸（22），铺满贴边，圆角由代码按「提醒」设置应用 -->
        <Border x:Name="IconBorder" Width="22" Height="22"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                CornerRadius="6"
                ClipToBounds="True">
            <Image x:Name="Icon" Width="22" Height="22" Stretch="UniformToFill"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="Text" FontWeight="Bold"
                   FontSize="{DynamicResource FontSizeEmphasis}"
                   VerticalAlignment="Center" TextAlignment="Center"/>
    </StackPanel>
</UserControl>
