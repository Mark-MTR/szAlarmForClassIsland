<controls:RuleSettingsControlBase x:TypeArguments="models:SzAlarmRuleSettings"
                                    x:Class="SzAlarmPlugin.SzAlarmRuleSettingsControl"
                                    xmlns="https://github.com/avaloniaui"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                                    xmlns:models="clr-namespace:SzAlarmPlugin.Models">
    <controls:RuleSettingsControlBase.Resources>
        <!-- Fluent 图标字体（ClassIsland 原生风格；Win10 回退到 MDL2） -->
        <FontFamily x:Key="FluentIcon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </controls:RuleSettingsControlBase.Resources>
    <ScrollViewer>
        <StackPanel Margin="8" Spacing="10">
            <!-- 实时预览卡片 -->
            <Border x:Name="PreviewCard"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="6" Padding="12,10">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource FluentIcon}" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="实时预览" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="PreviewSentence" TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <Border x:Name="MatchBadge" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                        <TextBlock x:Name="MatchInfo" FontSize="12.5" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Spacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="地名关键词" FontWeight="Bold"/>
                    <TextBox x:Name="TbRegions"
                             Watermark="如：南山 福田 宝安（留空=所有地区）"
                             TextChanged="OnInputChanged"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="灾害种类" FontWeight="Bold"/>
                    <TextBox x:Name="TbTypes"
                             Watermark="如：台风 暴雨 雷雨大风（留空=所有种类，严格相等）"
                             TextChanged="OnInputChanged"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="预警级别" FontWeight="Bold"/>
                    <TextBox x:Name="TbLevels"
                             Watermark="白 蓝 黄 橙 红（留空=所有级别）"
                             TextChanged="OnInputChanged"/>
                    <CheckBox x:Name="CbExclusive" Margin="0,4,0,0"
                              Content="有且仅有：不允许出现其它未列出的灾害种类"/>
                    <TextBlock Text="开启后：当前所有生效预警的种类都必须命中上面的「灾害种类」，且至少一条满足地名/级别，才判定为真。用于「全市只有台风预警才触发」这类场景（需至少填一个灾害种类）。"
                               FontSize="12" TextWrapping="Wrap" Opacity="0.7"/>
                    <TextBlock Text="三者为「与」关系：地名 ∩ 种类 ∩ 级别 同时满足，才判定为「存在预警」。"
                               FontSize="12" TextWrapping="Wrap" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</controls:RuleSettingsControlBase>
